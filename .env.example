HOST_PORT=3000
HOST_IP=127.0.0.1
REGISTRATION_ENABLED=false
MAX_FILE_BYTES=20971520
MAX_FILES=20
MAX_CONCURRENT_UPLOADS=2
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_FRAMES=100
COMPRESS_TARGET_BYTES=262144
COMPRESS_ATTEMPTS=4
